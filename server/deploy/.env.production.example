DATA_DIR=/srv/lunar-tear
IMAGE_TAG=local

GRPC_PUBLIC_ADDR=grpc.example.com:443
OCTO_PUBLIC_URL=https://octo.example.com
OCTO_RESOURCES_BASE_URL=https://assets.example.com

# The Android WebView login callback is fbconnect://success. Add another exact
# URI only if another client sends a different redirect_uri.
AUTH_ALLOWED_REDIRECT_URIS=fbconnect://success

# Set a non-empty admin token here or export LUNAR_ADMIN_TOKEN in the shell.
# The shell environment takes precedence over this file.
LUNAR_ADMIN_TOKEN=
