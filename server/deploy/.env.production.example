DATA_DIR=/srv/lunar-tear
IMAGE_TAG=local

GRPC_PUBLIC_ADDR=grpc.example.com:443
OCTO_PUBLIC_URL=https://octo.example.com
OCTO_RESOURCES_BASE_URL=https://assets.example.com

# Comma-separated exact callbacks used by the patched Android/iOS clients.
AUTH_ALLOWED_REDIRECT_URIS=fbconnect://cct.your.android.package,fb123456789://authorize/

# Generate with: openssl rand -hex 32
LUNAR_ADMIN_TOKEN=replace-with-a-random-token
